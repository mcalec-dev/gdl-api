{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "allowJs": true,
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "noEmit": true,
    "checkJs": true,
  },
  "include": ["**/*.js"],
  "exclude": ["node_modules/**/*", "min/**/*"]
}
