<head>
  <base href="<%= basePath ? `${basePath}/` : '/' %>" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="title" content="<%= title %>" />
  <meta name="description" content="<%= description %>" />
  <meta name="author" content="<%= author %>" />
  <meta name="keywords" content="<%= keywords %>" />
  <meta property="og:title" content="<%= title %>" />
  <meta property="og:description" content="<%= description %>" />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="<%= url %>" />
  <meta property="og:image" content="<%= basePath || '' %>/favicon.ico" />
  <meta name="msapplication-TileImage" content="<%= basePath || '' %>/ms-icon-144x144.png">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="<%= title %>">
  <meta name="apple-mobile-web-app-status-bar-style" content="black">
  <link rel="icon" type="image/x-icon" href="<%= basePath || '' %>/favicon.ico" />
  <link rel="shortcut icon" href="<%= basePath || '' %>/icons/favicon.ico" />
  <link rel="icon" type="image/png" sizes="192x192" href="<%= basePath || '' %>/icons/android-icon-192x192.png">
  <link rel="icon" type="image/png" sizes="32x32" href="<%= basePath || '' %>/icons/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="96x96" href="<%= basePath || '' %>/icons/favicon-96x96.png">
  <link rel="icon" type="image/png" sizes="16x16" href="<%= basePath || '' %>/icons/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="57x57" href="<%= basePath || '' %>/icons/apple-icon-57x57.png">
  <link rel="apple-touch-icon" sizes="60x60" href="<%= basePath || '' %>/icons/apple-icon-60x60.png">
  <link rel="apple-touch-icon" sizes="72x72" href="<%= basePath || '' %>/icons/apple-icon-72x72.png">
  <link rel="apple-touch-icon" sizes="76x76" href="<%= basePath || '' %>/icons/apple-icon-76x76.png">
  <link rel="apple-touch-icon" sizes="114x114" href="<%= basePath || '' %>/icons/apple-icon-114x114.png">
  <link rel="apple-touch-icon" sizes="120x120" href="<%= basePath || '' %>/icons/apple-icon-120x120.png">
  <link rel="apple-touch-icon" sizes="144x144" href="<%= basePath || '' %>/icons/apple-icon-144x144.png">
  <link rel="apple-touch-icon" sizes="152x152" href="<%= basePath || '' %>/icons/apple-icon-152x152.png">
  <link rel="apple-touch-icon" sizes="180x180" href="<%= basePath || '' %>/icons/apple-icon-180x180.png">
  <link rel="apple-touch-startup-image" href="<%= basePath || '' %>/icons/apple-icon.png" media="(device-width: 375px) and (device-height: 667px) and (-webkit-device-pixel-ratio: 2)" />
  <link rel="manifest" href="<%= basePath || '' %>/site.webmanifest" />
  <link rel="stylesheet" type="text/css" href="<%= basePath || '' %>/css/min/globals.min.css" />
  <link rel="stylesheet" type="text/css" href="<%= basePath || '' %>/css/min/tailwind.min.css" />
  <link rel="stylesheet" type="text/css" href="<%= basePath || '' %>/css/min/files.min.css" />
  <script defer src="https://umami.mcalec.dev/script.js" data-website-id="f52d5827-c06f-412f-a04c-768f17c840f5"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    window.BASE_PATH = "<%= basePath || '' %>";
    const nativeFetch = window.fetch.bind(window)
    window.fetch = (input, init) => {
      if (window.BASE_PATH && typeof input === 'string' && input.startsWith('/') && !input.startsWith(window.BASE_PATH + '/')) {
        input = window.BASE_PATH + input
      }
      return nativeFetch(input, init)
    }
  </script>
  <script>
    lucide.createIcons();
  </script>
</head>
